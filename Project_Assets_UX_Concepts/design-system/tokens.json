{
  "$comment": "Concept design tokens for portfolio work. Inspired by, not affiliated with, YouTube/Google. Figma Variables / Tokens Studio compatible (flat name -> value).",
  "color": {
    "light": {
      "bg": "#FFFFFF",
      "surface": "#F2F2F2",
      "surface-strong": "#E5E5E5",
      "border": "#E0E0E0",
      "text-primary": "#0F0F0F",
      "text-secondary": "#606060",
      "brand": "#CC0000",
      "brand-pressed": "#A30000",
      "on-brand": "#FFFFFF",
      "link": "#065FD4",
      "focus-ring": "#065FD4",
      "success": "#0B6B37",
      "warning": "#8A5300",
      "error": "#B3261E",
      "control-border": "#767676"
    },
    "dark": {
      "bg": "#0F0F0F",
      "surface": "#272727",
      "surface-strong": "#3F3F3F",
      "border": "#3F3F3F",
      "text-primary": "#F1F1F1",
      "text-secondary": "#AAAAAA",
      "brand": "#FF4E45",
      "brand-pressed": "#FF7A73",
      "on-brand": "#0F0F0F",
      "link": "#6EA8FE",
      "focus-ring": "#8AB4F8",
      "success": "#5DD28A",
      "warning": "#F2B056",
      "error": "#F2B8B5",
      "control-border": "#8A8A8A"
    },
    "dataviz": {
      "series-1": "#0072B2",
      "series-2": "#A86A00",
      "series-3": "#009E73",
      "series-4": "#D55E00",
      "series-5": "#6A4C93",
      "series-6": "#CC79A7",
      "comparison": "#8A8A8A",
      "$note": "Never encode meaning by color alone: pair with direct labels, markers or dash patterns."
    }
  },
  "typography": {
    "family": "Roboto, Inter, Arial, sans-serif",
    "scale": {
      "display": {
        "size": 28,
        "line": 36,
        "weight": 700
      },
      "title-1": {
        "size": 20,
        "line": 28,
        "weight": 700
      },
      "title-2": {
        "size": 16,
        "line": 24,
        "weight": 600
      },
      "body": {
        "size": 14,
        "line": 20,
        "weight": 400
      },
      "body-strong": {
        "size": 14,
        "line": 20,
        "weight": 600
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 400
      },
      "overline": {
        "size": 11,
        "line": 16,
        "weight": 600,
        "tracking": 0.5
      }
    }
  },
  "spacing": {
    "unit": 4,
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ]
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(0,0,0,.2)",
    "2": "0 4px 12px rgba(0,0,0,.24)"
  },
  "motion": {
    "duration": {
      "fast": 100,
      "base": 200,
      "slow": 320
    },
    "easing": {
      "standard": "cubic-bezier(.2,0,0,1)",
      "emphasized": "cubic-bezier(.3,0,0,1)"
    },
    "reduced-motion": "Replace transforms/slides with 0-100ms opacity fades"
  },
  "touch": {
    "min-target": 48,
    "min-gap": 8
  }
}